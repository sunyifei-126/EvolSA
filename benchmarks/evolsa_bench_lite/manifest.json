{
  "schema_version": "evolsa.taskpack/v1",
  "name": "incident-routing-lite",
  "license": "Apache-2.0",
  "adapter": "evolsa.demo.incident_routing:IncidentRoutingAdapter",
  "splits": {
    "mine": {"seeds": [0, 1, 2, 3], "feedback": "structured"},
    "validation": {"seeds": [0, 1, 2, 3], "feedback": "structured"},
