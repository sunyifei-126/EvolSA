{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:evolsa:schema:operator-passport:v1",
  "title": "EvolSA Operator Passport",
  "type": "object",
  "additionalProperties": false,
  "required": ["api_version", "name", "version", "intent", "inputs", "preconditions", "expected_effects", "forbidden_effects", "context_policy", "generator", "budget", "verification", "lifecycle"],
  "properties": {
    "api_version": {"const": "evolsa/v1"},
    "name": {"type": "string", "pattern": "^[a-z][a-z0-9-]{1,63}$"},
    "version": {"type": "string", "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-(?:0|[1-9][0-9]*|[0-9]*[A-Za-z-][0-9A-Za-z-]*)(?:\\.(?:0|[1-9][0-9]*|[0-9]*[A-Za-z-][0-9A-Za-z-]*))*)?(?:\\+[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?$"},
    "intent": {"type": "string", "minLength": 8},
    "parents": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
    "inputs": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
    "preconditions": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
    "expected_effects": {"type": "array", "items": {"enum": ["task_artifact", "operator", "scheduler", "memory_policy"]}, "uniqueItems": true},
    "forbidden_effects": {"type": "array", "items": {"enum": ["task_artifact", "operator", "scheduler", "memory_policy", "evaluator", "sandbox", "budget", "promotion_gate", "event_log", "release_permission"]}, "uniqueItems": true},
    "context_policy": {"type": "string", "minLength": 1},
    "generator": {
      "type": "object", "additionalProperties": false, "required": ["type", "ref"],
      "properties": {
        "type": {"enum": ["prompt_template", "tool_graph", "python", "adapter"]},
        "ref": {
          "type": "string",
          "anyOf": [
            {"pattern": "^sha256:[a-f0-9]{64}$"},
            {"pattern": "^(?!/)(?!.*[\\\\:])(?!\\.\\.(?:/|$))(?!.*?/\\.\\.(?:/|$))(?!.*[\\u0000-\\u001F\\u007F])[^/]+(?:/[^/]+)*$"}
          ]
        }
      }
    },
    "budget": {
      "type": "object", "additionalProperties": false, "required": ["max_tokens", "max_exec_seconds", "max_attempts"],
      "properties": {"max_tokens": {"type": "integer", "minimum": 0}, "max_exec_seconds": {"type": "number", "minimum": 0}, "max_attempts": {"type": "integer", "minimum": 1}, "max_cost": {"type": "number", "minimum": 0}}
    },
    "verification": {
      "type": "object", "additionalProperties": false, "required": ["baseline", "primary_metric", "guardrails", "minimum_tasks"],
      "properties": {"baseline": {"type": "string", "minLength": 1}, "primary_metric": {"type": "string", "minLength": 1}, "guardrails": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true}, "minimum_tasks": {"type": "integer", "minimum": 1}}
    },
    "known_failures": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
    "lifecycle": {"enum": ["proposed", "shadow", "candidate", "stable", "rejected", "quarantined", "deprecated"]},
    "evidence_ids": {"type": "array", "items": {"type": "string", "pattern": "^[a-f0-9]{64}$"}, "uniqueItems": true},
    "signature": {"type": "string"}
  }
}
